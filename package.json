{
  "name": "folder-sort",
  "private": true,
  "description": "Local image folder sorting with nested categories and folder export.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test e2e/library-minimal.spec.ts --project=chromium",
    "test:e2e:headed": "playwright test e2e/library-minimal.spec.ts --project=chromium --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "framer-motion": "^11.0.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "1.46.0",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "typescript": "^5.5.4",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
